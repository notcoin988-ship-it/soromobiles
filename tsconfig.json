{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["App.tsx", "index.ts", "src/**/*.ts", "src/**/*.tsx", "app.config.ts"],
  "exclude": [
    "node_modules",
    ".expo",
    ".test-build",
    "src/**/__tests__/**",
    // Тестовая инфраструктура собирается отдельным tsconfig.test.json:
    // она обращается к node:assert, которого в окружении приложения нет.
    "src/test/**",
    // Компонентные тесты идут через Jest со своими глобальными describe/it/
    // expect. Тянуть @types/jest в основную сборку значило бы объявить их
    // глобально и в коде приложения — там их быть не должно.
    "src/**/__components__/**"
  ]
}
